<%- include('partials/header') %>

<!-- Hero Section -->
<section class="relative min-h-screen flex items-center pt-20 overflow-hidden bg-brand-cream">
    <!-- Background Elements -->
    <div class="absolute top-0 right-0 w-2/3 h-full bg-[#E5E1D8] clip-path-hero -z-10 hidden lg:block opacity-50"></div>
    <div class="absolute top-1/4 -left-20 w-96 h-96 bg-brand-gold/10 rounded-full blur-[120px] -z-10 animate-float"></div>

    <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-12 gap-16 items-center">
        <div class="lg:col-span-7 space-y-10 animate-fade-in-up">
            <div class="space-y-6">
                <div class="inline-flex items-center space-x-2 bg-brand-navy/5 px-4 py-2 rounded-full">
                    <span class="w-2 h-2 bg-brand-gold rounded-full animate-pulse"></span>
                    <span class="text-[10px] font-black uppercase tracking-widest text-brand-navy/70 italic">Est. 1957 • A Premier Technical Institution</span>
                </div>
                <h1 class="text-5xl md:text-7xl font-serif font-bold text-brand-navy leading-[0.95] tracking-tight">
                    Madhav Institute <br/>
                    <span class="italic font-light text-brand-gold">of Technology & Science.</span><br/>
                    <span class="underline decoration-brand-navy/10 underline-offset-8">Shaping Futures in Gwalior.</span>
                </h1>
            </div>
            
            <p class="text-xl text-brand-navy/60 max-w-xl leading-relaxed font-medium">
                MITS Gwalior is an autonomous institute established to create world-class engineers through <span class="text-brand-navy font-bold">innovation, research,</span> and industry-focused pedagogy.
            </p>

            <div class="flex flex-col sm:flex-row gap-6">
                <button class="bg-brand-navy text-white px-10 py-5 rounded-2xl font-bold flex items-center justify-center hover:shadow-2xl hover:bg-brand-slate transition-all group uppercase text-xs tracking-widest">
                    Explore Departments <i data-lucide="arrow-right" class="ml-3 group-hover:translate-x-1 transition-transform w-5 h-5 text-brand-gold"></i>
                </button>
                <button class="bg-white text-brand-navy border border-brand-navy/10 px-10 py-5 rounded-2xl font-bold hover:bg-brand-cream transition-all uppercase text-xs tracking-widest">
                    Admission Inquiry
                </button>
            </div>

            <div class="flex items-center space-x-8 pt-4">
                <div class="flex -space-x-4">
                    <img src="image8" class="w-12 h-12 rounded-full border-4 border-white object-cover shadow-lg" alt="Student 1">
                    <img src="image9" class="w-12 h-12 rounded-full border-4 border-white object-cover shadow-lg" alt="Student 2">
                    <img src="image10" class="w-12 h-12 rounded-full border-4 border-white object-cover shadow-lg" alt="Student 3">
                    <div class="w-12 h-12 rounded-full border-4 border-white bg-brand-gold flex items-center justify-center text-[10px] font-bold text-brand-navy shadow-lg">+5k</div>
                </div>
                <div class="text-sm">
                    <p class="font-bold">5,000+ Active Students</p>
                    <p class="text-brand-navy/50">Across Engineering & Science Programs</p>
                </div>
            </div>
        </div>

        <!-- Hero Media -->
        <div class="lg:col-span-5 relative lg:h-[700px] flex items-center justify-center">
            <div class="relative z-10 w-full max-w-[480px] aspect-[4/5] bg-brand-navy rounded-[40px] overflow-hidden shadow-[0_50px_100px_-20px_rgba(10,25,47,0.3)] rotate-2 border-8 border-white">
                <img src="image1" class="w-full h-full object-cover grayscale-[0.2] hover:grayscale-0 transition-all duration-1000 scale-105 group-hover:scale-100" alt="MITS Campus">
            </div>
            <div class="absolute top-1/2 -right-10 transform -translate-y-1/2 w-full max-w-[420px] aspect-[4/5] border-2 border-brand-gold/40 rounded-[40px] -rotate-3 -z-10"></div>
            
            <!-- Floating Accreditation -->
            <div class="absolute -bottom-10 -left-6 z-20 bg-white p-8 rounded-3xl shadow-2xl border border-brand-navy/5 max-w-[300px] animate-float">
                <div class="flex items-center space-x-4 mb-3">
                    <div class="w-10 h-10 bg-brand-navy text-brand-gold rounded-xl flex items-center justify-center">
                        <i data-lucide="shield-check" class="w-6 h-6"></i>
                    </div>
                    <h4 class="font-extrabold text-brand-navy leading-tight uppercase text-xs tracking-widest">Autonomous Status</h4>
                </div>
                <p class="text-[11px] text-brand-navy/60 font-medium italic">"Recognized as a center of excellence by RGPV and AICTE for technical research."</p>
            </div>
        </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center space-y-2 opacity-50">
        <span class="text-[8px] font-black uppercase tracking-[0.5em] text-brand-navy animate-pulse">Scroll to Explore</span>
        <div class="w-px h-16 bg-gradient-to-b from-brand-navy to-transparent"></div>
    </div>
</section>

<!-- Quick Links / Digital Portals Section -->
<section class="py-20 bg-white relative z-20 -mt-10 lg:-mt-20">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-3 gap-8">
            <!-- Moodle -->
            <a href="https://moodle.mitsweb.in/my/" target="_blank" class="group p-10 rounded-[40px] border border-brand-navy/5 hover:shadow-2xl hover:-translate-y-2 transition-all duration-500">
                <div class="flex flex-col items-center text-center">
                    <!-- Moodle Logo -->
                    <div class="w-16 h-16 bg-orange-50 rounded-2xl flex items-center justify-center mb-6 group-hover:rotate-6 transition-transform shadow-sm">
                        <img src="logo.png" alt="Moodle" class="w-10 h-10 object-contain" onerror="this.style.display='none'">
                    </div>
                    <h3 class="text-2xl font-serif font-bold text-brand-navy mb-2">Moodle LMS</h3>
                    <p class="text-brand-navy/50 text-xs font-medium uppercase tracking-widest">Course Resources & Exams</p>
                </div>
            </a>

            <!-- AMS -->
            <a href="https://ams.mitsgwalior.in/" target="_blank" class="group p-10 rounded-[40px] border border-brand-navy/5 hover:shadow-2xl hover:-translate-y-2 transition-all duration-500">
                <div class="flex flex-col items-center text-center">
                    <!-- AMS Logo -->
                    <div class="w-16 h-16 bg-brand-navy rounded-2xl flex items-center justify-center mb-6 group-hover:rotate-6 transition-transform shadow-lg">
                        <img src="logo.png" alt="AMS" class="w-10 h-10 object-contain" onerror="this.style.display='none'">
                    </div>
                    <h3 class="text-2xl font-serif font-bold text-brand-navy mb-2">AMS Portal</h3>
                    <p class="text-brand-navy/50 text-xs font-medium uppercase tracking-widest">Attendance & Progress</p>
                </div>
            </a>

            <!-- IUMS -->
            <a href="https://iums.mitsgwalior.in/Login/StudentLogin.aspx" target="_blank" class="group p-10 rounded-[40px] border border-brand-navy/5 hover:shadow-2xl hover:-translate-y-2 transition-all duration-500">
                <div class="flex flex-col items-center text-center">
                    <!-- IUMS Logo -->
                    <div class="w-16 h-16 bg-blue-50 rounded-2xl flex items-center justify-center mb-6 group-hover:rotate-6 transition-transform shadow-sm">
                        <img src="logo.png" alt="IUMS" class="w-10 h-10 object-contain" onerror="this.style.display='none'">
                    </div>
                    <h3 class="text-2xl font-serif font-bold text-brand-navy mb-2">IUMS Login</h3>
                    <p class="text-brand-navy/50 text-xs font-medium uppercase tracking-widest">Enrollment & Records</p>
                </div>
            </a>
        </div>
    </div>
</section>
<!-- About Section -->
<section id="about" class="py-24 bg-white reveal">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-16 space-y-4">
            <h2 class="text-4xl md:text-5xl font-serif font-bold text-brand-navy">Welcome to <span class="text-brand-gold">MITS Gwalior</span></h2>
            <div class="flex items-center justify-center space-x-4">
                <div class="h-px w-12 bg-brand-gold"></div>
                <p class="text-brand-navy font-bold italic text-lg">“Mission to Innovate Technology for Society”</p>
                <div class="h-px w-12 bg-brand-gold"></div>
            </div>
        </div>

        <div class="grid lg:grid-cols-3 gap-0 rounded-[40px] overflow-hidden shadow-2xl border border-brand-navy/5">
            <!-- Vision Panel -->
            <div class="bg-brand-crimson p-12 text-white flex flex-col justify-center relative overflow-hidden group">
                <div class="absolute top-0 right-0 p-8 opacity-10 group-hover:scale-110 transition-transform">
                    <i data-lucide="eye" class="w-32 h-32"></i>
                </div>
                <h3 class="text-3xl font-serif font-bold mb-8 uppercase tracking-widest border-b border-white/20 pb-4 inline-block">Vision</h3>
                <div class="relative">
                    <i data-lucide="quote" class="w-10 h-10 text-white/30 mb-4"></i>
                    <p class="text-xl font-medium leading-relaxed italic">
                        To create world-class quality Engineers and Technocrats capable of providing leadership in all spheres of life and society.
                    </p>
                </div>
            </div>

            <!-- Vice Chancellor Panel -->
            <div class="relative min-h-[500px] flex flex-col items-center justify-end p-12 text-center text-white">
                <img src="image2" class="absolute inset-0 w-full h-full object-cover -z-10 brightness-50" alt="Campus View">
                <div class="bg-brand-navy/40 backdrop-blur-sm p-8 rounded-2xl border border-white/10 w-full">
                    <div class="w-32 h-32 rounded-2xl border-4 border-white mx-auto mb-6 overflow-hidden shadow-2xl">
                        <img src="panditsir.png" class="w-full h-full object-cover" alt="Director/VC">
                    </div>
                    <h4 class="text-2xl font-serif font-bold">Director's Message</h4>
                    <p class="text-brand-gold font-bold uppercase tracking-widest text-[10px] border-t border-white/10 mt-2 pt-2">Leadership at MITS</p>
                    <a href="#" class="inline-block mt-4 text-[9px] uppercase tracking-widest text-white/70 hover:text-brand-gold transition-colors underline decoration-brand-gold/40">Read Full Address</a>
                </div>
            </div>

            <!-- Mission Panel -->
            <div class="bg-brand-slate p-12 text-white flex flex-col justify-center group">
                <h3 class="text-3xl font-serif font-bold mb-8 uppercase tracking-widest border-b border-white/20 pb-4 inline-block">Mission</h3>
                <ul class="space-y-6">
                    <li class="flex items-start space-x-4 group/item">
                        <div class="w-6 h-6 rounded-full bg-brand-gold/20 flex items-center justify-center shrink-0 mt-1 group-hover/item:bg-brand-gold transition-colors">
                            <i data-lucide="chevron-right" class="w-4 h-4 text-brand-gold group-hover/item:text-brand-navy"></i>
                        </div>
                        <p class="text-sm text-white/80 leading-snug">To provide quality education in technical and allied disciplines.</p>
                    </li>
                    <li class="flex items-start space-x-4 group/item">
                        <div class="w-6 h-6 rounded-full bg-brand-gold/20 flex items-center justify-center shrink-0 mt-1 group-hover/item:bg-brand-gold transition-colors">
                            <i data-lucide="chevron-right" class="w-4 h-4 text-brand-gold group-hover/item:text-brand-navy"></i>
                        </div>
                        <p class="text-sm text-white/80 leading-snug">To promote research in the fields of Technology and Science.</p>
                    </li>
                    <li class="flex items-start space-x-4 group/item">
                        <div class="w-6 h-6 rounded-full bg-brand-gold/20 flex items-center justify-center shrink-0 mt-1 group-hover/item:bg-brand-gold transition-colors">
                            <i data-lucide="chevron-right" class="w-4 h-4 text-brand-gold group-hover/item:text-brand-navy"></i>
                        </div>
                        <p class="text-sm text-white/80 leading-snug">To meet global advancement through vocational and innovative courses.</p>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="bg-brand-navy py-16 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-12 text-center">
            <div class="reveal">
                <div class="text-5xl font-serif font-bold text-brand-gold mb-2">60+</div>
                <div class="text-[9px] text-white/40 uppercase tracking-[0.3em] font-black">Years of Legacy</div>
            </div>
            <div class="reveal" style="transition-delay: 100ms;">
                <div class="text-5xl font-serif font-bold text-brand-gold mb-2">90%</div>
                <div class="text-[9px] text-white/40 uppercase tracking-[0.3em] font-black">Placement Rate</div>
            </div>
            <div class="reveal" style="transition-delay: 200ms;">
                <div class="text-5xl font-serif font-bold text-brand-gold mb-2">15+</div>
                <div class="text-[9px] text-white/40 uppercase tracking-[0.3em] font-black">Academic Depts</div>
            </div>
            <div class="reveal" style="transition-delay: 300ms;">
                <div class="text-5xl font-serif font-bold text-brand-gold mb-2">45k+</div>
                <div class="text-[9px] text-white/40 uppercase tracking-[0.3em] font-black">Global Alumni</div>
            </div>
        </div>
    </div>
</section>

<!-- Departments -->
<section id="academics" class="py-32 bg-brand-cream">
    <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-col lg:flex-row justify-between items-end mb-20 gap-12 reveal">
            <div class="max-w-2xl space-y-6">
                <span class="text-brand-gold font-black uppercase tracking-[0.4em] text-[10px] bg-brand-gold/10 px-4 py-1.5 rounded-full">Academic Schools</span>
                <h2 class="text-5xl md:text-6xl font-serif font-bold text-brand-navy leading-tight">Excellence in Engineering.</h2>
                <p class="text-brand-navy/60 text-lg leading-relaxed font-medium">Discover our diverse range of engineering and architecture programs tailored for the modern industry.</p>
            </div>
            <button class="flex items-center space-x-3 text-brand-navy font-black text-xs uppercase tracking-widest group hover:text-brand-gold transition-colors">
                <span>Department Directory</span>
                <i data-lucide="arrow-right-circle" class="w-6 h-6 group-hover:translate-x-1 transition-transform"></i>
            </button>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
            <!-- CS/IT -->
            <div class="group relative aspect-[3/4] rounded-[40px] overflow-hidden reveal program-card">
                <img src="image4" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 grayscale group-hover:grayscale-0" alt="CSE Dept">
                <div class="absolute inset-0 bg-brand-navy/40 group-hover:bg-brand-navy/60 transition-colors"></div>
                <div class="absolute inset-0 p-10 flex flex-col justify-end z-10">
                    <div class="translate-y-8 group-hover:translate-y-0 transition-transform duration-500">
                        <h3 class="text-3xl font-serif font-bold text-white mb-4">CS & IT</h3>
                        <p class="text-white/70 text-sm mb-6 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                            Leading the digital revolution with AI, Machine Learning, and Cloud Computing.
                        </p>
                        <a href="#" class="text-brand-gold font-bold uppercase tracking-widest text-[10px] flex items-center">
                            View Department <i data-lucide="arrow-right" class="ml-2 w-3 h-3"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Civil & Arch -->
            <div class="group relative aspect-[3/4] rounded-[40px] overflow-hidden reveal program-card" style="transition-delay: 100ms;">
                <img src="image5" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 grayscale group-hover:grayscale-0" alt="Civil Dept">
                <div class="absolute inset-0 bg-brand-navy/40 group-hover:bg-brand-navy/60 transition-colors"></div>
                <div class="absolute inset-0 p-10 flex flex-col justify-end z-10">
                    <div class="translate-y-8 group-hover:translate-y-0 transition-transform duration-500">
                        <h3 class="text-3xl font-serif font-bold text-white mb-4">Civil & Arch</h3>
                        <p class="text-white/70 text-sm mb-6 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                            Designing sustainable urban landscapes and robust infrastructures.
                        </p>
                        <a href="#" class="text-brand-gold font-bold uppercase tracking-widest text-[10px] flex items-center">
                            View Department <i data-lucide="arrow-right" class="ml-2 w-3 h-3"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Electrical/Mechanical -->
            <div class="group relative aspect-[3/4] rounded-[40px] overflow-hidden reveal program-card" style="transition-delay: 200ms;">
                <img src="image6" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 grayscale group-hover:grayscale-0" alt="Mechanical Dept">
                <div class="absolute inset-0 bg-brand-navy/40 group-hover:bg-brand-navy/60 transition-colors"></div>
                <div class="absolute inset-0 p-10 flex flex-col justify-end z-10">
                    <div class="translate-y-8 group-hover:translate-y-0 transition-transform duration-500">
                        <h3 class="text-3xl font-serif font-bold text-white mb-4">Core Engg.</h3>
                        <p class="text-white/70 text-sm mb-6 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                            Powering the future through innovative mechanical and electrical systems.
                        </p>
                        <a href="#" class="text-brand-gold font-bold uppercase tracking-widest text-[10px] flex items-center">
                            View Department <i data-lucide="arrow-right" class="ml-2 w-3 h-3"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- News Section -->
<section class="py-32 bg-white">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-12 gap-16">
            <!-- News Column -->
            <div class="lg:col-span-7 space-y-12">
                <div class="flex justify-between items-end border-b border-brand-navy/10 pb-8 reveal">
                    <h2 class="text-4xl font-serif font-bold text-brand-navy">MITS Gazette</h2>
                    <a href="#" class="text-[10px] font-black uppercase tracking-[0.2em] text-brand-gold hover:text-brand-navy transition-colors">All Stories</a>
                </div>

                <div class="space-y-10">
                    <article class="flex flex-col md:flex-row gap-8 group cursor-pointer reveal">
                        <div class="md:w-56 aspect-video md:aspect-square rounded-3xl overflow-hidden shrink-0 border border-brand-navy/5">
                            <img src="image7" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="News Item">
                        </div>
                        <div class="space-y-3 pt-2">
                            <span class="text-[9px] font-black uppercase tracking-widest text-brand-gold">Campus Update • 2024</span>
                            <h3 class="text-2xl font-bold group-hover:text-brand-gold transition-colors leading-tight">MITS Gwalior Secures Record Placements in Core Engineering</h3>
                            <p class="text-brand-navy/50 text-sm line-clamp-2 leading-relaxed">This academic session, MITS students have shattered previous records with significant offers from top-tier firms...</p>
                            <div class="flex items-center text-brand-navy font-bold text-[9px] uppercase tracking-widest pt-2">
                                Read Article <i data-lucide="chevron-right" class="ml-1 w-3 h-3"></i>
                            </div>
                        </div>
                    </article>
                </div>
            </div>

            <!-- Newsletter / Inquiry Column -->
            <div class="lg:col-span-5 reveal" style="transition-delay: 200ms;">
                <div class="bg-brand-navy rounded-[40px] p-12 text-white relative overflow-hidden shadow-2xl">
                    <div class="absolute top-0 right-0 w-32 h-32 bg-brand-gold/10 rounded-full -translate-y-1/2 translate-x-1/2"></div>
                    <h3 class="text-3xl font-serif font-bold text-brand-gold mb-4">Admissions 2024-25</h3>
                    <p class="text-white/60 mb-8 leading-relaxed text-sm">Applications are now open for Undergraduate and Postgraduate programs. Request your brochure today.</p>
                    
                    <form id="newsletter-form" class="space-y-4">
                        <input type="text" placeholder="Full Name" class="w-full bg-white/5 border border-white/10 rounded-2xl py-4 px-6 outline-none focus:border-brand-gold transition-all text-sm mb-2" required>
                        <div class="relative">
                            <input type="email" placeholder="Email Address" class="w-full bg-white/5 border border-white/10 rounded-2xl py-4 px-6 outline-none focus:border-brand-gold transition-all text-sm" required>
                            <button type="submit" class="absolute right-2 top-2 bottom-2 bg-brand-gold text-brand-navy px-6 rounded-xl font-bold text-[10px] uppercase tracking-widest hover:bg-white transition-all">
                                Send Inquiry
                            </button>
                        </div>
                    </form>

                    <div class="mt-12 pt-10 border-t border-white/5 space-y-6">
                        <p class="text-[9px] font-black uppercase tracking-[0.3em] text-brand-gold">Events Calendar</p>
                        <div class="flex items-center justify-between group cursor-pointer border-b border-white/5 pb-4">
                            <div>
                                <p class="text-sm font-bold">Annual Tech Fest</p>
                                <p class="text-xs text-white/40">October 2024 • Main Campus</p>
                            </div>
                            <i data-lucide="arrow-right" class="w-4 h-4 opacity-40 group-hover:opacity-100 group-hover:text-brand-gold transition-all"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
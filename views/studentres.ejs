<%- include('partials/header') %>

<section class="relative pt-32 pb-20 overflow-hidden bg-brand-cream">
    <div class="absolute top-0 left-0 w-full h-full opacity-5 pointer-events-none -z-10">
        <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-brand-gold rounded-full blur-[120px]"></div>
    </div>

    <div class="max-w-7xl mx-auto px-6 text-center space-y-8 animate-fade-in-up">
        <div class="inline-flex items-center space-x-2 bg-brand-navy/5 px-4 py-2 rounded-full">
            <span class="w-2 h-2 bg-brand-gold rounded-full animate-pulse"></span>
            <span class="text-[10px] font-black uppercase tracking-widest text-brand-navy/70 italic">Student Central • All Essentials in One Place</span>
        </div>
        <h1 class="text-5xl md:text-7xl font-serif font-bold text-brand-navy leading-tight">
            Academic <span class="italic font-light text-brand-gold">& Student</span> Resources.
        </h1>
        <p class="text-xl text-brand-navy/60 max-w-2xl mx-auto leading-relaxed font-medium">
            Everything you need to navigate your journey at MITS, from digital portals to 
            placement support and campus welfare.
        </p>
    </div>
</section>

<section class="pb-24 bg-brand-cream relative z-10">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-3 gap-8">
            
            <div class="space-y-6 reveal">
                <div class="flex items-center space-x-4 mb-8">
                    <div class="h-px flex-grow bg-brand-navy/10"></div>
                    <h2 class="text-[11px] font-black uppercase tracking-[0.3em] text-brand-gold whitespace-nowrap">Academic Support</h2>
                    <div class="h-px w-12 bg-brand-navy/10"></div>
                </div>

                <div class="group bg-white p-8 rounded-[32px] border border-brand-navy/5 hover:shadow-2xl transition-all duration-500 cursor-pointer">
                    <div class="flex items-start justify-between">
                        <div class="space-y-4">
                            <div class="w-12 h-12 bg-brand-navy text-brand-gold rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform">
                                <i data-lucide="calendar" class="w-6 h-6"></i>
                            </div>
                            <h3 class="text-xl font-serif font-bold text-brand-navy">Academic Calendar</h3>
                            <p class="text-sm text-brand-navy/50 leading-relaxed">Stay updated with semester dates, holidays, and exam schedules.</p>
                        </div>
                        <i data-lucide="external-link" class="w-5 h-5 text-brand-navy/20 group-hover:text-brand-gold transition-colors"></i>
                    </div>
                </div>

                <div class="group bg-white p-8 rounded-[32px] border border-brand-navy/5 hover:shadow-2xl transition-all duration-500 cursor-pointer">
                    <div class="flex items-start justify-between">
                        <div class="space-y-4">
                            <div class="w-12 h-12 bg-brand-navy text-brand-gold rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform">
                                <i data-lucide="book-open" class="w-6 h-6"></i>
                            </div>
                            <h3 class="text-xl font-serif font-bold text-brand-navy">E-Library Portal</h3>
                            <p class="text-sm text-brand-navy/50 leading-relaxed">Access IEEE journals, digital books, and research databases remotely.</p>
                        </div>
                        <i data-lucide="external-link" class="w-5 h-5 text-brand-navy/20 group-hover:text-brand-gold transition-colors"></i>
                    </div>
                </div>
            </div>

            <div class="space-y-6 reveal" style="transition-delay: 150ms;">
                <div class="flex items-center space-x-4 mb-8">
                    <div class="h-px flex-grow bg-brand-navy/10"></div>
                    <h2 class="text-[11px] font-black uppercase tracking-[0.3em] text-brand-gold whitespace-nowrap">Campus Utilities</h2>
                    <div class="h-px w-12 bg-brand-navy/10"></div>
                </div>

                <div class="group bg-brand-navy p-8 rounded-[32px] text-white hover:shadow-[0_20px_50px_rgba(10,25,47,0.3)] transition-all duration-500 cursor-pointer relative overflow-hidden">
                    <div class="absolute -right-4 -top-4 w-24 h-24 bg-brand-gold/10 rounded-full"></div>
                    <div class="space-y-4 relative z-10">
                        <div class="w-12 h-12 bg-brand-gold text-brand-navy rounded-xl flex items-center justify-center">
                            <i data-lucide="credit-card" class="w-6 h-6"></i>
                        </div>
                        <h3 class="text-xl font-serif font-bold">Online Fee Payment</h3>
                        <p class="text-white/60 text-sm leading-relaxed">Pay semester fees, hostel charges, and exam fees securely through IUMS.</p>
                        <div class="flex items-center text-brand-gold text-[10px] font-bold uppercase tracking-widest pt-2">
                            Pay Now <i data-lucide="chevron-right" class="ml-1 w-3 h-3"></i>
                        </div>
                    </div>
                </div>

                <div class="group bg-white p-8 rounded-[32px] border border-brand-navy/5 hover:shadow-2xl transition-all duration-500 cursor-pointer">
                    <div class="flex items-start justify-between">
                        <div class="space-y-4">
                            <div class="w-12 h-12 bg-brand-navy text-brand-gold rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform">
                                <i data-lucide="home" class="w-6 h-6"></i>
                            </div>
                            <h3 class="text-xl font-serif font-bold text-brand-navy">Hostel Portal</h3>
                            <p class="text-sm text-brand-navy/50 leading-relaxed">Room allotments, mess menus, and grievance redressal for residents.</p>
                        </div>
                        <i data-lucide="external-link" class="w-5 h-5 text-brand-navy/20 group-hover:text-brand-gold transition-colors"></i>
                    </div>
                </div>
            </div>

            <div class="space-y-6 reveal" style="transition-delay: 300ms;">
                <div class="flex items-center space-x-4 mb-8">
                    <div class="h-px flex-grow bg-brand-navy/10"></div>
                    <h2 class="text-[11px] font-black uppercase tracking-[0.3em] text-brand-gold whitespace-nowrap">Career & Growth</h2>
                    <div class="h-px w-12 bg-brand-navy/10"></div>
                </div>

                <div class="group bg-white p-8 rounded-[32px] border border-brand-navy/5 hover:shadow-2xl transition-all duration-500 cursor-pointer">
                    <div class="flex items-start justify-between">
                        <div class="space-y-4">
                            <div class="w-12 h-12 bg-brand-navy text-brand-gold rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform">
                                <i data-lucide="briefcase" class="w-6 h-6"></i>
                            </div>
                            <h3 class="text-xl font-serif font-bold text-brand-navy">T&P Cell</h3>
                            <p class="text-sm text-brand-navy/50 leading-relaxed">Register for campus drives, internships, and view placement records.</p>
                        </div>
                        <i data-lucide="external-link" class="w-5 h-5 text-brand-navy/20 group-hover:text-brand-gold transition-colors"></i>
                    </div>
                </div>

                <div class="group bg-white p-8 rounded-[32px] border border-brand-navy/5 hover:shadow-2xl transition-all duration-500 cursor-pointer">
                    <div class="flex items-start justify-between">
                        <div class="space-y-4">
                            <div class="w-12 h-12 bg-brand-navy text-brand-gold rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform">
                                <i data-lucide="award" class="w-6 h-6"></i>
                            </div>
                            <h3 class="text-xl font-serif font-bold text-brand-navy">Scholarships</h3>
                            <p class="text-sm text-brand-navy/50 leading-relaxed">Information on Post-Metric, Merit-cum-Means, and state scholarships.</p>
                        </div>
                        <i data-lucide="external-link" class="w-5 h-5 text-brand-navy/20 group-hover:text-brand-gold transition-colors"></i>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
        <div class="bg-brand-slate rounded-[40px] p-12 lg:p-16 flex flex-col lg:flex-row items-center justify-between gap-12 relative overflow-hidden text-white">
            <div class="space-y-6 max-w-xl">
                <h2 class="text-4xl font-serif font-bold">Important <span class="text-brand-gold">Downloads</span></h2>
                <p class="text-white/60">Download standard formats for applications, certificates, and academic regulations.</p>
                <div class="grid sm:grid-cols-2 gap-4">
                    <a href="#" class="flex items-center p-4 bg-white/5 rounded-2xl border border-white/10 hover:bg-white/10 transition-colors group">
                        <i data-lucide="file-text" class="w-5 h-5 text-brand-gold mr-3"></i>
                        <span class="text-xs font-bold uppercase tracking-wider">Bonafide Certificate</span>
                    </a>
                    <a href="#" class="flex items-center p-4 bg-white/5 rounded-2xl border border-white/10 hover:bg-white/10 transition-colors group">
                        <i data-lucide="file-text" class="w-5 h-5 text-brand-gold mr-3"></i>
                        <span class="text-xs font-bold uppercase tracking-wider">Leave Application</span>
                    </a>
                </div>
            </div>
            
            <div class="bg-white/10 backdrop-blur-md p-10 rounded-3xl border border-white/10 w-full lg:max-w-md">
                <h4 class="text-xl font-serif font-bold mb-4">Need Assistance?</h4>
                <p class="text-sm text-white/60 mb-6 italic">Contact the Student Welfare Cell for any queries regarding resources.</p>
                <div class="space-y-4">
                    <div class="flex items-center space-x-3 text-sm">
                        <i data-lucide="mail" class="w-4 h-4 text-brand-gold"></i>
                        <span>welfare@mitsgwalior.in</span>
                    </div>
                    <div class="flex items-center space-x-3 text-sm">
                        <i data-lucide="phone" class="w-4 h-4 text-brand-gold"></i>
                        <span>+91 751 2409300</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
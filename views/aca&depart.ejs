<%- include('partials/header') %>

<!-- Page Hero -->

<section class="pt-56 pb-24 bg-brand-cream relative overflow-hidden">
<div class="absolute top-0 right-0 w-1/3 h-full bg-brand-gold/5 -z-10 skew-x-12"></div>
<div class="max-w-7xl mx-auto px-6 text-center">
<span class="text-brand-gold font-black uppercase tracking-[0.4em] text-[11px] mb-6 block">Academic Excellence at MITS</span>
<h1 class="text-5xl md:text-7xl font-serif font-bold text-brand-navy mb-8 leading-tight">
Architecting the <span class="italic font-light">Future Engineer.</span>
</h1>
<p class="text-xl text-brand-navy/60 max-w-2xl mx-auto font-medium">
Our pedagogical framework combines rigorous engineering fundamentals with industry-aligned research application across our specialized departments.
</p>
</div>
</section>

<!-- Academics / Schemes Section -->

<section id="schemes" class="py-24 bg-white reveal">
<div class="max-w-7xl mx-auto px-6">
<div class="flex flex-col lg:flex-row items-center gap-16">
<div class="lg:w-1/2 space-y-12">
<div class="space-y-4">
<h2 class="text-4xl font-serif font-bold text-brand-navy">Innovative Learning <span class="text-brand-gold">Schemes</span></h2>
<p class="text-brand-navy/60 leading-relaxed font-medium">MITS Gwalior offers specialized academic pathways designed to foster technical proficiency and professional leadership.</p>
</div>

            <div class="grid gap-8">
                <!-- Digital Learning -->
                <div class="flex gap-6 p-8 rounded-3xl bg-brand-cream border border-brand-navy/5 group hover:bg-white hover:shadow-2xl transition-all">
                    <div class="w-14 h-14 bg-brand-navy text-brand-gold rounded-2xl flex items-center justify-center shrink-0">
                        <i data-lucide="book-open" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h4 class="text-xl font-bold mb-2">NPTEL & SWAYAM Integration</h4>
                        <p class="text-sm text-brand-navy/50">Enhanced learning through premier digital certifications integrated into the credit-based autonomous curriculum.</p>
                    </div>
                </div>

                <!-- Merit Scholarship -->
                <div class="flex gap-6 p-8 rounded-3xl bg-brand-cream border border-brand-navy/5 group hover:bg-white hover:shadow-2xl transition-all">
                    <div class="w-14 h-14 bg-brand-gold text-brand-navy rounded-2xl flex items-center justify-center shrink-0">
                        <i data-lucide="award" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h4 class="text-xl font-bold mb-2">Chancellor's Scholarship Scheme</h4>
                        <p class="text-sm text-brand-navy/50">Financial support and academic stipends for meritorious students demonstrating exceptional technical potential.</p>
                    </div>
                </div>

                <!-- Industry Track -->
                <div class="flex gap-6 p-8 rounded-3xl bg-brand-cream border border-brand-navy/5 group hover:bg-white hover:shadow-2xl transition-all">
                    <div class="w-14 h-14 bg-brand-crimson text-white rounded-2xl flex items-center justify-center shrink-0">
                        <i data-lucide="factory" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h4 class="text-xl font-bold mb-2">Industry Internship Cell</h4>
                        <p class="text-sm text-brand-navy/50">Mandatory industrial training partnerships with leading firms like TCS, Infosys, and core engineering giants.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="lg:w-1/2 relative">
            <div class="relative rounded-[40px] overflow-hidden shadow-2xl rotate-2">
                <img src="image11" class="w-full object-cover" alt="MITS Academic Block">
            </div>
            <div class="absolute -top-10 -right-10 w-64 h-64 bg-brand-gold/10 rounded-full blur-3xl -z-10"></div>
        </div>
    </div>
</div>


</section>

<!-- Departments Section -->

<section id="departments" class="py-32 bg-brand-navy text-white overflow-hidden reveal">
<div class="max-w-7xl mx-auto px-6 relative z-10">
<div class="text-center mb-24">
<span class="text-brand-gold font-black uppercase tracking-[0.4em] text-[10px] mb-4 block">Academic Departments</span>
<h2 class="text-5xl font-serif font-bold mb-8">Engineering & Science</h2>
<div class="h-1 w-24 bg-brand-gold mx-auto"></div>
</div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Dept 1 -->
        <div class="dept-card bg-brand-slate p-12 rounded-[40px] border border-white/5 relative group cursor-pointer overflow-hidden">
            <div class="absolute -right-8 -top-8 w-32 h-32 bg-brand-gold/5 rounded-full group-hover:scale-150 transition-transform"></div>
            <i data-lucide="code" class="w-12 h-12 text-brand-gold mb-8"></i>
            <h3 class="text-2xl font-serif font-bold mb-4">Computer Science & IT</h3>
            <p class="text-white/50 text-sm mb-8 leading-relaxed">Pioneering in Software Engineering, AI/ML research, and cybersecurity systems.</p>
            <div class="flex items-center text-[10px] font-black uppercase tracking-widest text-brand-gold group-hover:translate-x-2 transition-transform">
                Explore Faculty <i data-lucide="arrow-right" class="ml-2 w-4 h-4"></i>
            </div>
        </div>

        <!-- Dept 2 -->
        <div class="dept-card bg-brand-slate p-12 rounded-[40px] border border-white/5 relative group cursor-pointer overflow-hidden">
            <i data-lucide="zap" class="w-12 h-12 text-brand-gold mb-8"></i>
            <h3 class="text-2xl font-serif font-bold mb-4">Electrical Engineering</h3>
            <p class="text-white/50 text-sm mb-8 leading-relaxed">Focusing on Power Systems, Renewable Energy, and Smart Grid technologies.</p>
            <div class="flex items-center text-[10px] font-black uppercase tracking-widest text-brand-gold group-hover:translate-x-2 transition-transform">
                Explore Labs <i data-lucide="arrow-right" class="ml-2 w-4 h-4"></i>
            </div>
        </div>

        <!-- Dept 3 -->
        <div class="dept-card bg-brand-slate p-12 rounded-[40px] border border-white/5 relative group cursor-pointer overflow-hidden">
            <i data-lucide="settings" class="w-12 h-12 text-brand-gold mb-8"></i>
            <h3 class="text-2xl font-serif font-bold mb-4">Mechanical Engineering</h3>
            <p class="text-white/50 text-sm mb-8 leading-relaxed">Advanced research in Robotics, Thermal Engineering, and Automobile design.</p>
            <div class="flex items-center text-[10px] font-black uppercase tracking-widest text-brand-gold group-hover:translate-x-2 transition-transform">
                View Workshops <i data-lucide="arrow-right" class="ml-2 w-4 h-4"></i>
            </div>
        </div>

        <!-- Dept 4 -->
        <div class="dept-card bg-brand-slate p-12 rounded-[40px] border border-white/5 relative group cursor-pointer overflow-hidden">
            <i data-lucide="building" class="w-12 h-12 text-brand-gold mb-8"></i>
            <h3 class="text-2xl font-serif font-bold mb-4">Civil Engineering</h3>
            <p class="text-white/50 text-sm mb-8 leading-relaxed">Sustainable infrastructure development and Structural Engineering excellence.</p>
            <div class="flex items-center text-[10px] font-black uppercase tracking-widest text-brand-gold group-hover:translate-x-2 transition-transform">
                Department Info <i data-lucide="arrow-right" class="ml-2 w-4 h-4"></i>
            </div>
        </div>

        <!-- Dept 5 -->
        <div class="dept-card bg-brand-slate p-12 rounded-[40px] border border-white/5 relative group cursor-pointer overflow-hidden">
            <i data-lucide="compass" class="w-12 h-12 text-brand-gold mb-8"></i>
            <h3 class="text-2xl font-serif font-bold mb-4">Architecture</h3>
            <p class="text-white/50 text-sm mb-8 leading-relaxed">Fostering creativity through Sustainable Urbanism and Human-Centric Design.</p>
            <div class="flex items-center text-[10px] font-black uppercase tracking-widest text-brand-gold group-hover:translate-x-2 transition-transform">
                Studio Tours <i data-lucide="arrow-right" class="ml-2 w-4 h-4"></i>
            </div>
        </div>

        <!-- Dept 6 -->
        <div class="dept-card bg-brand-slate p-12 rounded-[40px] border border-white/5 relative group cursor-pointer overflow-hidden">
            <i data-lucide="flask-conical" class="w-12 h-12 text-brand-gold mb-8"></i>
            <h3 class="text-2xl font-serif font-bold mb-4">Applied Sciences</h3>
            <p class="text-white/50 text-sm mb-8 leading-relaxed">The foundational block covering Physics, Chemistry, and Mathematics research.</p>
            <div class="flex items-center text-[10px] font-black uppercase tracking-widest text-brand-gold group-hover:translate-x-2 transition-transform">
                Research Areas <i data-lucide="arrow-right" class="ml-2 w-3 h-3"></i>
            </div>
        </div>
    </div>
</div>


</section>

<%- include('partials/footer') %>